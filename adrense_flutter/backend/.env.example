DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/adrense_db
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LOCAL DEVELOPMENT ONLY: remove this setting in production.
ADR_ADMIN_PASSWORD=Admin@123

# Authentication email delivery (SMTP provider credentials; never commit backend/.env)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=ADRense <no-reply@your-domain.com>
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_STARTTLS=true
SMTP_SSL=false
